# dependencies and build output (added when the monorepo exists)
node_modules/
.pnpm-store/
.turbo/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# environment and secrets — only *.example files are committed
.env
.env.*
!.env.example
!.env.*.example

# provider local state
.vercel/

# React Native / Expo local state and generated native projects.
# `android/` and `ios/` are generated by `expo prebuild` (CNG) from `app.json` and the config
# plugins, so they are build output rather than source: committing them would mean two places
# where a permission string or a native dependency can be changed, and one of them would lose.
.expo/
.expo-export*/
apps/field/android/
apps/field/ios/

# Railway: the infrastructure definition is source, everything else the CLI writes is local state
.railway/*
!.railway/railway.ts
!.railway/README.md

# test artefacts
playwright-report/
test-results/
# Playwright storage states written by `e2e/auth.setup.ts`: each file holds a live
# `better-auth.session_token` for one synthetic demo identity. The identities are synthetic and
# their password comes from `DEMO_USER_PASSWORD` in the environment only (IG3-001), so nothing
# real is at risk — but a session token is a credential, and a credential does not belong in
# version control. Regenerated by every run; never committed.
e2e/.auth/
**/__screenshots__/**/*-actual.png
**/__screenshots__/**/*-diff.png

# editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# local tool state
.claude/launch.json

# Playwright (report dirs are already covered above)
blob-report/
apps/web/public/vendor/

# dependencies and build output (added when the monorepo exists)
node_modules/
.pnpm-store/
.turbo/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# environment and secrets — only *.example files are committed
.env
.env.*
!.env.example
!.env.*.example

# provider local state
.vercel/

# React Native / Expo local state and generated native projects.
# `android/` and `ios/` are generated by `expo prebuild` (CNG) from `app.json` and the config
# plugins, so they are build output rather than source: committing them would mean two places
# where a permission string or a native dependency can be changed, and one of them would lose.
.expo/
.expo-export*/
apps/field/android/
apps/field/ios/

# Railway: the infrastructure definition is source, everything else the CLI writes is local state
.railway/*
!.railway/railway.ts
!.railway/README.md

# test artefacts
playwright-report/
test-results/
**/__screenshots__/**/*-actual.png
**/__screenshots__/**/*-diff.png

# editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# local tool state
.claude/launch.json

# Playwright (report dirs are already covered above)
blob-report/
apps/web/public/vendor/

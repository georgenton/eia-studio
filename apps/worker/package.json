{
  "name": "@eia/worker",
  "version": "0.0.0",
  "private": true,
  "description": "EIA Studio persistent worker process (job consumer foundation)",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@eia/application": "workspace:*",
    "@eia/contracts": "workspace:*",
    "@eia/db": "workspace:*",
    "@eia/domain": "workspace:*",
    "pg": "8.23.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@eia/config": "workspace:*",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}

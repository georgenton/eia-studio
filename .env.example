# EIA Studio — local development environment (copy to .env, never commit .env).
# Values below are development-only defaults matching docker-compose.yml.

# application
APP_ENV=local                      # local | test | preview | staging | production
PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# database — three roles, three URLs (ADR-004, ADR-013)
# host port published by docker-compose (change if 5433 is taken on your machine)
EIA_PG_PORT=5433
# runtime role: RLS enforced, no BYPASSRLS, no DDL
DATABASE_URL=postgres://eia_app_login:eia_app_dev_password@localhost:5433/eia_studio
# migrator role: schema owner, used only by `pnpm db:migrate` and provisioning scripts
DATABASE_MIGRATOR_URL=postgres://postgres:postgres@localhost:5433/eia_studio
# runtime login role provisioned by `pnpm db:provision-runtime-role` (name + password only here)
DATABASE_APP_ROLE_NAME=eia_app_login
DATABASE_APP_ROLE_PASSWORD=eia_app_dev_password

# authentication (Better Auth: identity, authentication, sessions only — ADR-010)
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters-for-local-dev
BETTER_AUTH_URL=http://localhost:3000

# email — Slice 0 uses the console adapter; no provider selected yet
EMAIL_ADAPTER=console              # console | noop
EMAIL_FROM=no-reply@localhost

# object storage — boundary only in Slice 0; leave unset unless the S3 adapter is configured
# STORAGE_ENDPOINT=
# STORAGE_REGION=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# worker (persistent process)
WORKER_HEALTH_PORT=3100
WORKER_HEARTBEAT_MS=15000
WORKER_SHUTDOWN_TIMEOUT_MS=10000
WORKER_DB_CHECK=true

# demo fixtures (synthetic, PII-free); must be false in production
DEMO_FIXTURES_ENABLED=true

# social assisted coding (Slice 4 / IG4-001) — NO DEFAULT, on purpose.
# Unset means assisted coding is unavailable here; deterministic tabulation is unaffected.
#   fake        deterministic in-process classifier. Automated tests and local development only;
#               refused whenever APP_ENV is not `local` or `test`.
#   ai-gateway  live adapter (AI SDK through the Vercel AI Gateway); needs AI_GATEWAY_API_KEY.
# There is no fallback in either direction: a gateway without its key reports
# BLOCKED_EXTERNAL_CONFIG rather than quietly producing fabricated codings.
# SOCIAL_CLASSIFIER=fake
# SOCIAL_CLASSIFIER_MODEL=fake/deterministic
# AI_GATEWAY_API_KEY=            # name only; never commit a value

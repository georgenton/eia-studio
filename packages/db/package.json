{
  "name": "@eia/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, SQL migrations (roles, RLS, extensions), RLS-scoped transaction helper",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "check": "node scripts/check-migrations.mjs",
    "migrate": "tsx scripts/migrate.ts",
    "provision-runtime-role": "tsx scripts/provision-runtime-role.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "probe": "node scripts/capability-probe.mjs"
  },
  "dependencies": {
    "@eia/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eia/config": "workspace:*",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
